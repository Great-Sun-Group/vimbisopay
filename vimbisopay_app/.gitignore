# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Platform-specific generated files
**/linux/flutter/ephemeral/
**/linux/flutter/generated_*
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.*
**/macos/Flutter/Flutter-*.xcconfig
**/macos/Flutter/flutter_export_environment.sh

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android native build files
**/android/app/.cxx/
**/android/app/.cxx/**/*.so
**/android/app/.cxx/**/*.a
**/android/app/.cxx/**/*.o
**/android/app/.cxx/**/*.d
**/android/app/.cxx/**/*.ninja
**/android/app/.cxx/**/*.cmake
**/android/app/.cxx/**/*.bin
**/android/app/.cxx/**/*.json
**/android/app/.cxx/**/*.txt
**/android/app/.cxx/**/CMakeFiles/

# Test coverage
/coverage/

# Sensitive configuration files
.env
.api_env_prod
lib/core/config/api_config.dart
lib/core/config/encryption_config.dart
scripts/github_config.sh
android/app/google-services.json
ios/GoogleService-Info.plist

# Signing keys and properties
*.jks
*.keystore
android/key.properties
